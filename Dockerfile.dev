# Tetrics Development Dockerfile
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    curl \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN pip install poetry

# Configure Poetry
RUN poetry config virtualenvs.create false

# Configure Poetry authentication for Nexus repository
# Accept build arguments for Nexus credentials
ARG NEXUS_USER
ARG NEXUS_PASSWORD

# Configure Poetry HTTP authentication and install dependencies
RUN poetry config http-basic.lks-next-all "$NEXUS_USER" "$NEXUS_PASSWORD" && \
    poetry config http-basic.lksnexus-pypi "$NEXUS_USER" "$NEXUS_PASSWORD"

# Copy dependency files
COPY pyproject.toml poetry.lock ./

# Install Python dependencies
RUN poetry install

# Create logs directory
RUN mkdir -p logs

# Install CLI as a system command
RUN printf '#!/bin/bash\nexec python /app/cli.py "$@"\n' > /usr/local/bin/tetrics && chmod +x /usr/local/bin/tetrics

# Copy entrypoint script
COPY docker-entrypoint.sh /app/
# Normalize line endings (CRLF to LF) and ensure executable permissions
RUN sed -i 's/\r$//' /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run entrypoint script with sh to handle line endings robustly
ENTRYPOINT ["/bin/sh", "-c", "sed -i 's/\\r$//' /app/docker-entrypoint.sh && exec /app/docker-entrypoint.sh"]
